server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Allow large torrent uploads (covers both /upload and /json base64 fallback)
    client_max_body_size 200m;

    # Health check for orchestrators
    location /health {
        access_log off;
        return 200 "OK";
        add_header Content-Type text/plain;
    }

    # Proxy Deluge JSON-RPC — keeps requests same-origin so there is no CORS issue
    location /json {
        proxy_pass ${DELUGE_URL};
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Proxy Deluge torrent upload
    location /upload {
        proxy_pass ${DELUGE_URL};
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Serve Deluge state .torrent files for cross-seed export (requires volume mount)
    location ~* "^/torrent/([0-9a-f]{40})\.torrent$" {
        alias /deluge-config/state/$1.torrent;
        add_header Content-Disposition 'attachment; filename="$1.torrent"';
        add_header Content-Type 'application/x-bittorrent';
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
